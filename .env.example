# GreenBubble API tokens
# ─────────────────────
# Copy this file to .env and fill in your own tokens.
# .env is gitignored — never commit it.
#
# Renewables.ninja  →  https://www.renewables.ninja/documentation/api
RN_TOKEN=your_renewables_ninja_token_here

# ENTSO-E Transparency Platform  →  https://transparency.entsoe.eu/usrm/user/createPublicUser
ENTSOE_API_KEY=your_entsoe_token_here

# EIA Open Data (US only)  →  https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_eia_token_here
